<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>WarehouseApp.Desktop</RootNamespace>
  </PropertyGroup>

  <!-- Host ASP.NET Core in-process (Kestrel) inside the WPF process. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WarehouseApp.Api\WarehouseApp.Api.csproj"
                      AdditionalProperties="ExcludeApiAppSettingsFromPublish=true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Copy the built React bundle (web/dist) into wwwroot next to the exe so the
    WebView2 virtual host (https://app.local/) can serve it offline. Runs only
    once the bundle has been produced with `npm run build`.
  -->
  <Target Name="CopyReactBundleAfterBuild" AfterTargets="Build"
          Condition="Exists('$(MSBuildProjectDirectory)\..\..\web\dist')">
    <ItemGroup>
      <ReactDist Include="$(MSBuildProjectDirectory)\..\..\web\dist\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ReactDist)"
          DestinationFiles="@(ReactDist->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyReactBundleAfterPublish" AfterTargets="Publish"
          Condition="Exists('$(MSBuildProjectDirectory)\..\..\web\dist')">
    <ItemGroup>
      <ReactDistForPublish Include="$(MSBuildProjectDirectory)\..\..\web\dist\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ReactDistForPublish)"
          DestinationFiles="@(ReactDistForPublish->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
