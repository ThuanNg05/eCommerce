<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\WarehouseApp.Infrastructure\WarehouseApp.Infrastructure.csproj" />
  </ItemGroup>

  <!-- The WPF host owns the combined appsettings.json in desktop publishes. -->
  <ItemGroup Condition="'$(ExcludeApiAppSettingsFromPublish)' == 'true'">
    <Content Update="appsettings.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.16.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>WarehouseApp.Api-7b09a040-5518-40b6-982e-d95b29fd22c8</UserSecretsId>
  </PropertyGroup>

</Project>
